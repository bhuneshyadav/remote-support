listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=INJECT_FROM_SECRET_MANAGER
realm=turn.example.invalid
# If coturn is behind NAT, set external-ip=PUBLIC_IP/PRIVATE_CONTAINER_IP.
# Ensure the min/max relay port range is forwarded unchanged through the firewall.
min-port=49160
max-port=49999
no-cli
no-multicast-peers
stale-nonce=600
total-quota=1000
user-quota=4
max-bps=1000000
no-loopback-peers
no-tcp-relay
cert=/run/secrets/turn_certificate
pkey=/run/secrets/turn_private_key
