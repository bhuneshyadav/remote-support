# Copy to vercel-backend.env on the Linux VPS running the API and TURN relay.
API_DOMAIN=api.example.com
WEB_ORIGIN=https://your-project.vercel.app
TURN_PUBLIC_IP=203.0.113.10
TURN_PRIVATE_IP=10.0.0.10

# Copy the Supabase Session pooler URL (port 5432) and URL-encode reserved password characters.
DATABASE_URL=postgresql://prisma.project-ref:encoded-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Use fresh random hex strings; do not reuse development secrets.
SESSION_CODE_HMAC_KEY=replace-with-at-least-32-random-bytes
TURN_SHARED_SECRET=replace-with-a-different-random-secret

# Configure an OIDC SPA client and matching API audience before deployment.
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=replace-with-api-audience
OIDC_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
